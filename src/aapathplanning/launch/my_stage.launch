<launch>
  <arg name="model" default="$(env TURTLEBOT3_MODEL)" doc="model type [burger, waffle, waffle_pi]"/>

  <!-- ✅ 默认出生点：避开动态障碍/静态柱子，减少翻车概率 -->
  <arg name="x_pos" default="-1 "/>
  <arg name="y_pos" default="1.6"/>
  <arg name="z_pos" default="0.02"/>
  <arg name="yaw"   default="3.14159"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find aapathplanning)/world/siyuan_world.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro --inorder $(find turtlebot3_description)/urdf/turtlebot3_$(arg model).urdf.xacro" />

  <!-- ✅ 加了 -Y 控制朝向 -->
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf"
        args="-urdf -model turtlebot3_$(arg model)
              -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -Y $(arg yaw)
              -param robot_description" />

  <!-- 旧的 slalom mover：默认关闭，避免抢控制/鬼畜 -->
  <arg name="run_slalom_2_mover" default="false"/>
  <group if="$(arg run_slalom_2_mover)">
    <node pkg="aapathplanning" type="Slalom_2.py" name="Slalom_2_mover"
          output="screen" respawn="false">
      <description>
        该节点负责实时控制场景中的 Slalom_2 模型。
        请确保 Slalom_2.py 第一行是 #!/usr/bin/env python3 且有执行权限。
      </description>
    </node>
  </group>
</launch>