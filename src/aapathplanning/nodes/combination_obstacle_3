#!/usr/bin/env python3
import rospy
import time
import math  # 导入 math 库
from gazebo_msgs.msg import ModelState, ModelStates

class Combination():
    def __init__(self):
        self.pub_model = rospy.Publisher('gazebo/set_model_state', ModelState, queue_size=1)
        self.moving()

    def moving(self):
        time.sleep(100)
        state = 0
        center_x = 2
        center_y = -2.5
        radius = 1.5  # 圆周运动的半径
        angular_speed = 0.05  # 角速度，控制圆周运动的速度
        linear_speed = 0.01  # 初始移动速度
        start_y = -2.5  # 初始位置 y 坐标
        end_y = -4  # 终点位置 y 坐标
        curve_factor = 0.5  # 控制弧线弯曲的程度
        while not rospy.is_shutdown():
            model = rospy.wait_for_message('gazebo/model_states', ModelStates)
            
            for i in range(len(model.name)):
                if model.name[i] == 'obstacle_3':
                    obstacle_3 = ModelState()
                    obstacle_3.model_name = model.name[i]
                    obstacle_3.pose = model.pose[i]

                    # 第一步：从 (2, -2.5) 走弧线移动到 (2, -4)
                    if state == 0:
                        # 计算 y 方向的移动（线性下降）
                        obstacle_3.pose.position.y -= linear_speed

                        # 根据 y 变化，生成弧线轨迹，让 x 变化形成弧线
                        t = (obstacle_3.pose.position.y - start_y) / (end_y - start_y)  # 归一化 t 值 (0 到 1)
                        obstacle_3.pose.position.x = 2 + curve_factor * math.sin(t * math.pi)  # x 方向弧线变化

                        # 当障碍物到达 (2, -4) 时，进入圆周运动状态
                        if obstacle_3.pose.position.y <= -4:
                            state = 1
                            start_time = time.time()  # 记录圆周运动的开始时间
                            start_angle = math.atan2(obstacle_3.pose.position.y - center_y, 
                                                     obstacle_3.pose.position.x - center_x)  # 计算初始角度

                    # 第二步：围绕 (2, -2.5) 开始圆周运动
                    elif state == 1:
                        current_time = time.time()
                        theta = start_angle + angular_speed * (current_time - start_time)  # 平滑增加角度

                        # 计算新的坐标，围绕 (2, -2.5) 进行圆周运动
                        obstacle_3.pose.position.x = center_x + radius * math.cos(theta)
                        obstacle_3.pose.position.y = center_y + radius * math.sin(theta)

                    # 发布障碍物的更新位置
                    self.pub_model.publish(obstacle_3)
                    time.sleep(0.1)  # 控制更新频率

def main():
    rospy.init_node('combination_obstacle_3')
    try:
        combination = Combination()
    except rospy.ROSInterruptException:
        pass

if __name__ == '__main__':
    main()