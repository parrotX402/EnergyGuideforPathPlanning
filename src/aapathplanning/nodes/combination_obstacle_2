#!/usr/bin/env python3

import rospy
import time
import math
from gazebo_msgs.msg import ModelState, ModelStates

class Combination():
    def __init__(self):
        # 发布器：修改 Gazebo 模型状态
        self.pub_model = rospy.Publisher('gazebo/set_model_state', ModelState, queue_size=1)
        self.target_model_name = 'Slalom_2' # 修改为你的地图中的名字
        self.moving()

    def moving(self):
        # 缩短等待时间，确保实验快速开始
        time.sleep(2) 
        
        # 运动参数设置
        center_y = 0.0      # Y 轴运动中心
        amplitude = 1.2     # 左右移动的振幅（米）
        frequency = 0.5     # 运动频率
        
        rospy.loginfo(f"开始控制动态障碍物: {self.target_model_name}")

        while not rospy.is_shutdown():
            try:
                # 获取当前所有模型状态
                model = rospy.wait_for_message('gazebo/model_states', ModelStates, timeout=1.0)
            except rospy.ROSException:
                continue

            found = False
            for i in range(len(model.name)):
                # 兼容性检查：匹配 Slalom_2 或 obstacle_2
                if model.name[i] in [self.target_model_name, 'obstacle_2', 'Slalom_2']:
                    found = True
                    obstacle = ModelState()
                    obstacle.model_name = model.name[i]
                    obstacle.pose = model.pose[i]
                    
                    # 计算正弦波平滑位移
                    # 使用 rospy.get_time() 获取仿真时间，避免时间回退崩溃
                    curr_sim_time = rospy.get_time()
                    
                    # 只改变 Y 坐标，实现左右横移
                    obstacle.pose.position.y = center_y + amplitude * math.sin(frequency * curr_sim_time)
                    
                    # 保持方向不变（或者你可以让它旋转）
                    obstacle.pose.orientation.w = 1.0 

                    # 发布更新
                    self.pub_model.publish(obstacle)
            
            if not found:
                rospy.logwarn_once(f"未在场景中找到模型: {self.target_model_name}，请检查地图命名")

            # 使用 rospy.Rate 替代 time.sleep，更好地适配仿真时钟
            try:
                rospy.sleep(0.05) 
            except (rospy.exceptions.ROSInterruptException, rospy.exceptions.ROSTimeMovedBackwardsException):
                pass

def main():
    # 节点初始化
    rospy.init_node('combination_obstacle_2', anonymous=True)
    try:
        Combination()
    except rospy.ROSInterruptException:
        pass

if __name__ == '__main__':
    main()
